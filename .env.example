# Dental Backend Environment Configuration
# Copy this to .env and fill in values

# ============================================================
# DATABASE (Required)
# ============================================================
DB_HOST=127.0.0.1                    # localhost for local, Cloud SQL socket for prod
DB_USER=dental_user
DB_NAME=dental_db
DB_PASS=your-database-password
DB_PORT=5432                         # Default 5432, use 5433 for Cloud SQL Proxy

# ============================================================
# SECURITY (Required)
# ============================================================
ENCRYPTION_KEY=                      # Fernet key for PII encryption (use: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=                          # JWT signing key

# ============================================================
# LLM / AI SUMMARIES
# ============================================================
OPENAI_API_KEY=                      # Required for patient summary generation
LLM_PROVIDER=openai                  # openai | gemini | anthropic
LLM_MODEL=gpt-4o-mini                # Override default model

# ============================================================
# SUMMARY GENERATION MODE
# ============================================================
# For local development without Cloud Tasks:
SUMMARY_SYNC_MODE=true               # Generate summaries synchronously in request thread

# For production with Cloud Tasks:
# CLOUD_TASKS_QUEUE=dental-summary-queue
# GCP_PROJECT=your-project-id
# CLOUD_TASKS_LOCATION=us-central1
# SERVICE_URL=https://your-backend.run.app
# SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com

# Debouncing (prevents "edit storm" from triggering multiple generations)
SUMMARY_DEBOUNCE_SECONDS=300         # Default 5 minutes
